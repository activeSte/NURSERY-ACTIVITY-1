    "gmail":    { "consent": false, "mode": "read+draft" },
    "calendar": { "consent": false, "mode": "read+propose" },
    "drive":    { "consent": false, "mode": "read+file" },
    "tasks":    { "consent": false, "mode": "read+write" },

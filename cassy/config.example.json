  "delivery": { "email": true, "calendar": false, "sheet": true, "notionPage": "Cassy Daily" },
  "staleDealDays": 14,
  "guardrails": {
    "outboundSendRequiresApproval": true,
    "externalInviteRequiresApproval": true,
    "deleteRequiresApproval": true,
    "pecAutoAction": false,
    "redactPiiInLogs": true
  },
  "bridges": {
    "note": "Libero / Yahoo / AOL / Aruba Webmail / Aruba PEC have no API connector in this environment.",
